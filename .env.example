# Local development template only. Process environment values take precedence.
# Test, staging, and production never load this file.

# Telegram
TELEGRAM_BOT_TOKEN=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_SECURITY=STARTTLS
SMTP_TIMEOUT=10

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/grant_tracker

# Application
ENVIRONMENT=development
RELEASE_ID=local
CHECK_INTERVAL=900
LOG_LEVEL=INFO
PORT=8080

# Provider and outbound I/O timeouts (seconds)
GRANT_URL=https://www.firstinspires.org/programs/team-grant-opportunities
PROVIDER_TIMEOUT=15
TELEGRAM_TIMEOUT=30
DATABASE_TIMEOUT=10
POLLING_BACKLOG_POLICY=process

# Transactional outbox policy
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF=30
OUTBOX_MAX_BACKOFF=3600
OUTBOX_LEASE_SECONDS=120
